# Supabase — copy this file to .env and fill in your values
# Found in: Supabase Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used only by the ingestion script (server-side).
# Found in: Supabase Dashboard → Project Settings → API → service_role
# WARNING: never expose this in the mobile app or commit it to git.
SUPABASE_SERVICE_KEY=your-service-role-key-here
